LOG_LEVEL=INFO

HTTP_ADDR=:8083

LLM_MODEL=GigaChat-2-Max
# main-B2B ждёт ответ 90 с (AI_SERVICE_TIMEOUT), LLM должна уложиться раньше
LLM_TIMEOUT=80
LLM_MAX_TOKENS=4096
# Одновременных запросов к LLM, 0 — без ограничения. На бесплатном тарифе GigaChat — 1
LLM_MAX_CONCURRENCY=1
LLM_TEMPERATURE=0.1
# 1.0 — без штрафа за повторы, иначе модель коверкает повторяющиеся ключи JSON
LLM_REPETITION_PENALTY=1.0
# prompt — схема ответа в промпте; json_schema — beta-режим GigaChat (вставляет мусор в JSON)
LLM_OUTPUT_MODE=prompt

# SDK gigachat: GIGACHAT_API_PERS — физлица; GIGACHAT_API_B2B / GIGACHAT_API_CORP — юрлица
GIGACHAT_SCOPE=GIGACHAT_API_PERS

# Справочник услуг клиники: GET {MIS_URL}/api/v1/services (contracts/mis-demo.md)
MIS_URL=http://localhost:8081
MIS_TIMEOUT=5
CATALOG_TTL=300

KNOWLEDGE_DIR=knowledge
