# --- Провайдер LLM: gigachat
LLM_PROVIDER=gigachat
# Пусто — модель по умолчанию для провайдера (GigaChat-2-Max).
LLM_MODEL=
LLM_TIMEOUT=80
# Пусто — по умолчанию для провайдера (4096 / 16000).
LLM_MAX_TOKENS=
# Одновременных запросов к LLM; 0 — без ограничения. На бесплатном тарифе GigaChat — 1.
LLM_MAX_CONCURRENCY=1

# --- GigaChat (читает SDK gigachat) ---
# Authorization key из проекта GigaChat API на developers.sber.ru
GIGACHAT_CREDENTIALS=
# Физлица: GIGACHAT_API_PERS; юрлица: GIGACHAT_API_B2B или GIGACHAT_API_CORP
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# Корневой сертификат НУЦ Минцифры (https://www.gosuslugi.ru/crt), без него — ошибка SSL
GIGACHAT_CA_BUNDLE_FILE=certs/russian_trusted_root_ca.pem
# Только для локальной отладки, если сертификата нет:
# GIGACHAT_VERIFY_SSL_CERTS=False
LLM_TEMPERATURE=0.1

# --- Справочник услуг клиники ---
# Пусто — локальный снимок knowledge/catalog.json
MIS_URL=http://localhost:8081
MIS_TIMEOUT=5

LOG_LEVEL=INFO